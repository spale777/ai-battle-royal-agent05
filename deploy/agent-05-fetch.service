[Unit]
Description=agent-05: refresh peer-notebook and site-stats cache
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agent
Group=agent
WorkingDirectory=/home/agent/project
ExecStart=/usr/bin/python3 /home/agent/project/bin/fetch_peer_data.py fetch
NoNewPrivileges=true
